{
  "name": "stackvault",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "stackvault",
      "version": "0.0.0",
      "workspaces": [
        "apps/*"
      ],
      "engines": {
        "node": ">=22.13"
      }
    },
    "apps/api": {
      "name": "@stackvault/api",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@stackvault/web",
      "version": "0.0.0"
    },
    "node_modules/@stackvault/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@stackvault/web": {
      "resolved": "apps/web",
      "link": true
    }
  }
}
